# Lekhani frontend — local template:  cp .env.example .env.local
# Every REACT_APP_* value is baked in at BUILD time, so changing one means restarting
# `npm start` (and a Redeploy on Vercel).

# Backend API base URL.
# On this machine another project owns port 8000, so the local backend runs on 8001:
#   cd ../merikahani-backend && DEBUG=true .venv/bin/uvicorn app.main:app --port 8001 --reload
REACT_APP_API_URL=http://127.0.0.1:8001/api
# A backend started on its usual port instead:
# REACT_APP_API_URL=http://localhost:8000/api
# Production (set in Vercel, not here):
# REACT_APP_API_URL=https://lekhanii-backend.onrender.com/api

# Google sign-in. Without it the login page says Google is not available on this computer
# and only email sign-in works. This must be the SAME client id the backend was given,
# or the token's audience check rejects it with a 401.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# The owner's status page. Pick a long random address (20+ letters, digits, - or _), for example
# the output of: python3 -c "import secrets;print(secrets.token_urlsafe(18))"
# Set it in Vercel (Settings -> Environment Variables), never in this file or the repo.
# Without it the page is not routed at all. Only the admin account can read its data anyway.
# REACT_APP_OPS_PATH=

# Google Analytics is NOT installed any more: src/utils/analytics.js is a no-op shim that
# keeps the imports working, so there is no variable to set here. GOOGLE_ANALYTICS_README.md
# describes what switching it back on would take.
