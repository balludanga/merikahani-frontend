{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lekhanii-backend.onrender.com/api/:path*"
    },
    {
      "source": "/rss.xml",
      "destination": "https://lekhanii-backend.onrender.com/api/rss.xml"
    },
    {
      "source": "/post/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "https://lekhanii-backend.onrender.com/api/prerender/post/:slug"
    },
    {
      "source": "/sitemap-posts.xml",
      "destination": "https://lekhanii-backend.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/tag/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "https://lekhanii-backend.onrender.com/api/prerender/tag/:slug"
    },
    {
      "source": "/user/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "https://lekhanii-backend.onrender.com/api/prerender/user/:id"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/about.html"
    },
    {
      "source": "/help",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/help.html"
    },
    {
      "source": "/rules",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/rules.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/privacy.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/terms.html"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/blog.html"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|Mediapartners-Google|bingbot|BingPreview|msnbot|DuckDuckBot|YandexBot|Baiduspider|Sogou|Slurp|Applebot|SeznamBot|PetalBot|Qwantify|facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterestbot|redditbot|SkypeUriPreview|vkShare|Embedly).*"
        }
      ],
      "destination": "/_bot/blog/:slug/index.html"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://lekhanii-backend.onrender.com https://accounts.google.com https://www.google-analytics.com; frame-src https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
